# VAYNTR Talent — environment reference
#
# Real values belong in the Render dashboard (Environment tab) and in GitHub
# Actions repository secrets. Never commit them or paste them into chat.
#
# The API service on Render needs the variables in the first block. The second
# block is only for the frontend build, and the third is for the keep-alive job.

# --- API service (Render web service) ---------------------------------------
# Render injects PORT; keep 10000 if you set it manually.
PORT=10000
# Only set this on a service that runs the API alone. With NODE_ENV=production,
# `npm install` skips devDependencies, which breaks a Next.js frontend build.
NODE_ENV=production

# Render Postgres → "Internal Database URL". Use the external URL only when
# connecting from outside Render.
DATABASE_URL=

# 32+ random characters. Signs sessions and derives the at-rest encryption key.
JWT_SECRET=

# Comma-separated browser origins allowed to call the API with credentials.
FRONTEND_ORIGINS=https://vayntr-talent.onrender.com,https://nappygorilla.github.io

# Resend transactional email. RESEND_FROM_EMAIL must use a domain verified in
# Resend; without both values email notifications are skipped, not fatal.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VAYNTR Talent <no-reply@your-verified-domain>
RESEND_REPLY_TO=

# 32+ random characters guarding the staff review surface.
STAFF_REVIEW_TOKEN=

# Optional Postgres TLS overrides. Leave unset unless the provider needs them.
# PGSSLMODE=require
# PG_SSL_REJECT_UNAUTHORIZED=true

# --- Frontend build ---------------------------------------------------------
# Only needed when the API is served from a different origin than the app.
# NEXT_PUBLIC_API_URL=https://vayntr-talent.onrender.com

# --- GitHub Actions ---------------------------------------------------------
# Repository secret read by .github/workflows/keepalive.yml.
# BACKEND_URL=https://vayntr-talent.onrender.com
